rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio content sections (home, about, skills, contact, etc.)
    match /portfolio_content/{section} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Projects collection
    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Skills collection
    match /skills/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Certifications collection
    match /certifications/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Volunteer collection
    match /volunteer/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Hackathons collection
    match /hackathons/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Open Source collection
    match /open_source/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Contact form submissions
    match /contact_submissions/{docId} {
      allow read: if request.auth != null;
      allow create: if true;  // Anyone can submit a form
      allow update, delete: if request.auth != null;
    }
    
    // Resume downloads tracking
    match /resume_downloads/{docId} {
      allow read: if request.auth != null;
      allow create: if true;  // Anyone can track a download
      allow update, delete: if request.auth != null;
    }
    
    // Default deny for other collections
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
